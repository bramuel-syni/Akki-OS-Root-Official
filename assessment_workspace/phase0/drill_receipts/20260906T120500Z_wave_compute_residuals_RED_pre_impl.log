    def test_r1_rules_never_fabricate_prototype_numbers():
        """A r1 rule that renders "1,240 hrs" or "43%" or any of the prototype
        numeric strings when the estate can't measure them is a fabrication
        defect. Freeze this with a per-rule scan of the rule block."""
        src = _source()
        # Prototype numeric strings this wave is refusing to fabricate.
        fabrication_strings = {
            "1,240 hrs committed",
            "2,880 hrs",
            "1,640 hrs",
            "645 hrs",
            "298 hrs",
            "174 hrs",
            "99 hrs",
            "24 hrs",
            "274 hrs",
            "339 hrs",
            "65 hrs",
            "43 hrs",
            "43%",
            "52%",
            "24%",
            "14%",
            "8%",
            "2%",
            "38%",
            "47%",
            "9%",
            "6%",
            "57%",
        }
        fabrications = []
        scanned = 0
        for name in R1_RULE_NAMES:
            idx = src.find(f'name: "{name}"')
            if idx == -1:
                fabrications.append((name, "<rule not declared in App.js>"))
                continue
            scanned += 1
            block = src[idx : idx + 1500]
            # renderFragments block only — extract the arrow-function body.
            rf_match = re.search(
                r'renderFragments:\s*\([^)]*\)\s*=>\s*\{([^}]+(?:\{[^}]*\}[^}]*)*)\}',
                block,
            )
            if not rf_match:
                fabrications.append((name, "<renderFragments body not found>"))
                continue
            rf_body = rf_match.group(1)
            for fab in fabrication_strings:
                # The dummy itself appearing in the rule declaration (in the
                # `dummyContent:` field) is fine — it's the target text. We only
                # care about the renderFragments body.
                if fab in rf_body:
                    fabrications.append((name, fab))
