    def test_each_rule_dummy_content_matches_inventory():
        """The dummyContent string a rule targets MUST equal the verbatim dummy
        it was authored against. If a code change edits the dummy but not the
        inventory (or vice versa), this test fires with the specific mismatch."""
        src = _source()
        mismatches = []
        iterated = 0
        for name, (dummy, _anchor) in COMPUTE_RESIDUALS_RULES.items():
            # Grab the block starting at `name: "<name>"` up to the next rule
            # opener (~800 chars is enough for one rule).
            idx = src.find(f'name: "{name}"')
            if idx == -1:
                mismatches.append((name, "<rule not declared in App.js>", dummy))
                continue
            iterated += 1
            block = src[idx : idx + 1200]
            # Match dummyContent field (may span with unicode escapes).
            # Rules are allowed to author dummies using either the literal
            # UTF-8 middot / en-dash OR their \u escapes — both are honest.
            m = re.search(r'dummyContent:\s*"([^"]*)"', block)
            if not m:
                mismatches.append((name, "dummyContent field missing", dummy))
                continue
            got = m.group(1)
            # Normalise \u escapes to their character equivalents for compare.
            got_normalised = got.encode("utf-8").decode("unicode_escape")
            if got != dummy and got_normalised != dummy:
                mismatches.append((name, got, dummy))
>       assert not mismatches, (
            f"rule dummyContent mismatches (name, got, expected): {mismatches}"
        )
