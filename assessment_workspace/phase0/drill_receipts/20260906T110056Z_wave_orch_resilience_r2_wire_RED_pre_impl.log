    def test_orch_burn_one_host_launch_conditional_on_adopt_mode(orch_tree: ast.Module):
        """`burn_one_host` MUST skip the `_launch_burn(...)` call when in adopt
        mode (the on-host burn is already running from the prior orchestrator;
        re-launching would either fail or start a second burn — either is bad)."""
        fn = _find_function(orch_tree, "burn_one_host")
        assert fn is not None
        # Find _launch_burn(...) call
        launch_calls = []
        for c in ast.walk(fn):
            if isinstance(c, ast.Call):
                nm = ""
                if isinstance(c.func, ast.Name):
                    nm = c.func.id
                elif isinstance(c.func, ast.Attribute):
                    nm = c.func.attr
                if nm == "_launch_burn":
                    launch_calls.append(c)
        assert launch_calls, "burn_one_host does not call _launch_burn — orchestrator is broken"
        # Each _launch_burn call MUST be inside an `if`/`if not` gated on adopt state.
        for lc in launch_calls:
            # Find the enclosing If in burn_one_host
            found_gate = False
            for ifnode in [n for n in ast.walk(fn) if isinstance(n, ast.If)]:
                # Is lc inside ifnode's body or orelse?
                for stmt in ifnode.body + ifnode.orelse:
                    for sub in ast.walk(stmt):
                        if sub is lc:
                            # Now check the If condition references an adopt-shaped var
                            cond_src = ast.dump(ifnode.test)
                            if any(k in cond_src for k in
                                   ("ADOPT", "_ADOPT", "adopt")):
                                found_gate = True
                                break
                    if found_gate:
                        break
                if found_gate:
                    break
