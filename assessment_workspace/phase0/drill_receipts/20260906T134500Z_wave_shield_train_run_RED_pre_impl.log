    def execute_governed_lora_run(
        tier: str,
        recipe_version: str,
        base_model_id: str,
        material_admit_ref: str,
        host_slug: str,
        table_context: str,
        slice_size: int,
        backend_execute: Callable[[str, Dict[str, Any]], List[Dict[str, Any]]],
        ssh_seam: Any,
    ) -> Dict[str, Any]:
        """End-to-end governed LoRA training run.
    
        Gate: consults services.chokepoint.masking_tier admissibility for
        `tier` under the current AKKI_ENV. If not admissible, raises
        `MaskingTierNotAdmitted` BEFORE any backend / SSH activity. This
        replaces the previous unconditional `RealSSHNotWiredYet` stub —
        the STUB is gone; the ADMISSION GATE is what remains.
    
        When admission lands (owner rules by editing
        `services/chokepoint/masking_tier_allowlist.v0.json`), this
        function proceeds through: row extract → build masked corpus →
        stage → LoRA fine-tune (the SSH-invoked training loop is landed by
        a subsequent wave — for now, admissible tier raises
        NotImplementedError as an honest place-holder rather than
        silently succeeding).
        """
        # 1. Admission gate.
        from services.chokepoint import masking_tier as _mt
        env = os.environ.get("AKKI_ENV", "")
        try:
            _mt.validate_tier(tier, akki_env=env)
        except _mt.MaskingTierRefused as exc:
            raise MaskingTierNotAdmitted(
                f"masking tier {tier!r} not admissible under AKKI_ENV={env!r}. "
                f"Original refusal: {exc}. Admission is parked pending owner "
                f"ruling — see services/chokepoint/masking_tier_allowlist.v0.json "
                f"§tier {tier} prerequisites_status field."
            ) from exc
        # 2. Admission was granted — proceed with governed pipeline.
        #    Row extract, corpus build, stage, launch are the sub-steps.
        #    This wave lands the gate + admission-parked path; the
        #    full training loop is chartered as W-Shield-Train-run.
