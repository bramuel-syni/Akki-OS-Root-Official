    def test_execute_governed_lora_run_transport_integrity_still_refuses(tmp_path):
        """Regression: sha256-mismatch on transport still raises
        TransportIntegrityRefusal (from build-wave)."""
        from backend.services.shield_train import pipeline as p
        rows = [
            {"option_string": f"opt-{i}", "question_string": f"q-{i}", "value_chain": "dairy"}
            for i in range(50)
        ]
        seam = _FakeSeam()
        # Corrupt the remote sha to force mismatch on the FIRST put
        class _BadSeam(_FakeSeam):
            def run(self, cmd):
                r = super().run(cmd)
                if cmd.startswith("sha256sum "):
                    r["stdout"] = "deadbeef" + "0" * 56 + "  /tmp/foo\n"
                return r
        bad = _BadSeam()
        env = {
            "AKKI_ENV": "development",
            "SHIELD_TRAIN_STAGE_LOCAL_DIR": str(tmp_path / "local"),
            "SHIELD_TRAIN_HELD_OUT_RECEIPT_DIR": str(tmp_path / "receipts"),
        }
        with mock.patch.dict(os.environ, env, clear=False):
            with pytest.raises(p.TransportIntegrityRefusal):
>               p.execute_governed_lora_run(
                    tier="t1_full_mask",
                    recipe_version="v1",
                    base_model_id="Qwen/Qwen2.5-0.5B",
