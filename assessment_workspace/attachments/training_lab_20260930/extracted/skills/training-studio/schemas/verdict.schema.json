{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIF verdict record",
  "type": "object",
  "required": [
    "verdict_id",
    "brief_ref",
    "goal",
    "frame_ref",
    "candidates",
    "adopted",
    "manifest",
    "confirmed_by",
    "confirmed_at",
    "objections_accepted",
    "objections_overruled"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "idea_id",
          "name",
          "assembly",
          "verdict",
          "lens"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "adopt",
              "reject",
              "rank",
              "defer"
            ]
          },
          "lens": {
            "enum": [
              "professor",
              "researcher",
              "industry",
              "entrepreneur"
            ]
          }
        }
      }
    },
    "manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assumption",
          "class",
          "source",
          "flips"
        ],
        "properties": {
          "class": {
            "enum": [
              "fact",
              "recalled",
              "inferred"
            ]
          }
        }
      }
    },
    "objections_accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lens",
          "objection",
          "action"
        ]
      }
    },
    "objections_overruled": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lens",
          "objection",
          "reason"
        ]
      }
    }
  }
}