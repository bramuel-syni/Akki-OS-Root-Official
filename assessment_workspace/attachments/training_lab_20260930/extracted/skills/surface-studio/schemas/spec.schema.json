{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surface spec \u2014 authored blocks by reference",
  "type": "object",
  "required": [
    "spec_type",
    "spec_id",
    "page_state_ref",
    "brief_ref",
    "verdict_ref",
    "role",
    "page",
    "seed",
    "build_stamp",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_type": {
      "const": "surface_spec"
    },
    "spec_id": {
      "type": "string"
    },
    "page_state_ref": {
      "type": "string",
      "pattern": "@\\d+$"
    },
    "brief_ref": {
      "type": "string"
    },
    "verdict_ref": {
      "type": "string"
    },
    "role": {
      "enum": [
        "board",
        "exco",
        "security_officer",
        "operator",
        "depot_lead"
      ]
    },
    "page": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "minLength": 4
    },
    "build_stamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "move",
          "title",
          "text",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "move": {
            "enum": [
              "interpret",
              "report",
              "trigger",
              "silence"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "minItems": 1
          },
          "kind": {
            "enum": [
              "decision_pending",
              "advisory",
              "anomaly"
            ]
          },
          "pending_ref": {
            "type": "string"
          },
          "causal_ref": {
            "type": "string"
          },
          "silence_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}