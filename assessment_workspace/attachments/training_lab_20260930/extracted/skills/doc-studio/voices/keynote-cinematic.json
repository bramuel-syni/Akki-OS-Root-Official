{
  "voice_id": "keynote-cinematic",
  "family": "keynote",
  "objectives": [
    "inspire",
    "persuade"
  ],
  "description": "One idea, one line, one figure per slide. Full-bleed structure field on statement slides, white field on evidence slides. Large type, long margins, no bullets. Built for a room, not a read-ahead.",
  "structural": {
    "title_style": "statement",
    "title_max_chars": 70,
    "title_max_lines": 2,
    "exhibits_per_slide": 1,
    "words_per_slide_max": 30,
    "requires": [
      "hero",
      "closing",
      "coverage_limits"
    ],
    "no_winner_marked": true,
    "so_what_required_on_exhibits": true,
    "coverage_title": "What we know, what we don't, and what would close the gap"
  },
  "compatibility": {
    "allowed_palettes": [
      "graphite",
      "slate",
      "ink",
      "harbour",
      "moss"
    ],
    "allowed_type_pairs": [
      "arial-arial",
      "century-arial",
      "cambria-calibri"
    ],
    "veto": [
      {
        "palette": "ink",
        "type_pair": "century-arial",
        "why": "gold accent on near-black with a bookish serif reads as a wine label"
      },
      {
        "palette": "graphite",
        "cover": "title-left-high",
        "why": "red accent needs the lower cover composition to avoid a warning-sign read"
      }
    ],
    "printed_requires_field": "FFFFFF"
  },
  "sizes_pt": {
    "kicker": 12,
    "title": 30,
    "body": 18,
    "small": 10,
    "big_number": 120,
    "section_number": 96,
    "section_title": 36,
    "cover_title": 54,
    "cover_sub": 20,
    "hero": 44,
    "closing": 40,
    "table": 14
  },
  "grid": {
    "slide_w": 13.333,
    "slide_h": 7.5,
    "cols": 12,
    "rows": 16,
    "margin_x": 1.1,
    "margin_y": 0.6,
    "gutter": 0.2
  },
  "layouts": {
