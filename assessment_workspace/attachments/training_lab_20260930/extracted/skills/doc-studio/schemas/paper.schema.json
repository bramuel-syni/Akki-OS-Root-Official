{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper format spec",
  "type": "object",
  "required": [
    "spec_type",
    "spec_id",
    "content_ref",
    "brief_ref",
    "verdict_ref",
    "objective",
    "family",
    "voice",
    "seed",
    "build_stamp",
    "title",
    "sections"
  ],
  "properties": {
    "spec_type": {
      "const": "paper"
    },
    "content_ref": {
      "type": "string",
      "pattern": "@\\d+$"
    },
    "seed": {
      "type": "string",
      "minLength": 4
    },
    "build_stamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "blocks"
        ]
      }
    }
  }
}