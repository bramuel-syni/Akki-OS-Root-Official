{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run plan \u2014 references only",
  "type": "object",
  "required": [
    "spec_type",
    "spec_id",
    "objective_ref",
    "brief_ref",
    "verdict_ref",
    "backend",
    "seed",
    "build_stamp",
    "recipe",
    "stages",
    "milestones",
    "outputs"
  ],
  "properties": {
    "spec_type": {
      "const": "run_plan"
    },
    "backend": {
      "enum": [
        "real",
        "stub"
      ]
    },
    "seed": {
      "type": "string",
      "minLength": 4
    },
    "build_stamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "recipe": {
      "type": "object",
      "required": [
        "training_params_ref",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "empty",
            "filled"
          ]
        },
        "training_params_ref": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "comparison_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "enum": [
              "calibration",
              "comparison",
              "quote",
              "full"
            ]
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "done_when",
          "owner"
        ]
      }
    },
    "spec_id": {
      "type": "string"
    },
    "objective_ref": {
      "type": "string",
      "pattern": "@\\d+$"
    },
    "brief_ref": {
      "type": "string"
    },
    "verdict_ref": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "run-record",
          "report-md",
          "moac-pack"
        ]
      }
    }
  },
  "additionalProperties": false
}