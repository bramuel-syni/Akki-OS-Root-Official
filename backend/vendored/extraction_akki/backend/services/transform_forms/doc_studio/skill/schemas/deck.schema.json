{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck format spec",
  "type": "object",
  "required": [
    "spec_type",
    "spec_id",
    "content_ref",
    "brief_ref",
    "verdict_ref",
    "objective",
    "family",
    "voice",
    "seed",
    "build_stamp",
    "slides"
  ],
  "properties": {
    "spec_type": {
      "const": "deck"
    },
    "content_ref": {
      "type": "string",
      "pattern": "@\\d+$"
    },
    "seed": {
      "type": "string",
      "minLength": 4
    },
    "build_stamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "slides": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "cover",
              "exec_summary",
              "section",
              "assertion_exhibit",
              "assertion_points",
              "comparison",
              "coverage_limits",
              "appendix",
              "hero",
              "big_number",
              "closing",
              "table",
              "glossary"
            ]
          }
        }
      }
    }
  }
}