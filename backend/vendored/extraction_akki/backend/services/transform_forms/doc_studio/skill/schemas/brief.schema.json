{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assignment brief \u2014 six dimensions",
  "type": "object",
  "required": [
    "brief_id",
    "content_ref",
    "purpose",
    "audience",
    "setting",
    "content",
    "brand",
    "outputs"
  ],
  "properties": {
    "purpose": {
      "type": "object",
      "required": [
        "kind",
        "statement"
      ],
      "properties": {
        "kind": {
          "enum": [
            "decide",
            "persuade",
            "report",
            "explain",
            "inspire",
            "align",
            "document"
          ]
        }
      }
    },
    "audience": {
      "type": "object",
      "required": [
        "who",
        "knowledge",
        "priorities",
        "detail"
      ]
    },
    "setting": {
      "type": "object",
      "required": [
        "mode",
        "read_unattended",
        "printed"
      ]
    },
    "content": {
      "type": "object"
    },
    "brand": {
      "type": "object",
      "required": [
        "house",
        "formality",
        "expressiveness",
        "variation_allowed"
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "format",
          "role"
        ],
        "properties": {
          "format": {
            "enum": [
              "pptx",
              "docx",
              "xlsx",
              "html",
              "pdf",
              "md"
            ]
          }
        }
      }
    }
  }
}