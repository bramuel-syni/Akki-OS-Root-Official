{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIF verdict record for a creative direction",
  "type": "object",
  "required": [
    "verdict_id",
    "brief_ref",
    "goal",
    "frame_ref",
    "candidates",
    "adopted",
    "manifest",
    "confirmed_by",
    "confirmed_at"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "idea_id",
          "name",
          "assembly",
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "adopt",
              "reject",
              "rank",
              "defer"
            ]
          },
          "assembly": {
            "type": "object",
            "required": [
              "narrative",
              "compositions",
              "treatment",
              "density",
              "imagery"
            ]
          }
        }
      }
    },
    "manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assumption",
          "class",
          "source",
          "flips"
        ],
        "properties": {
          "class": {
            "enum": [
              "fact",
              "recalled",
              "inferred"
            ]
          },
          "flips": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}