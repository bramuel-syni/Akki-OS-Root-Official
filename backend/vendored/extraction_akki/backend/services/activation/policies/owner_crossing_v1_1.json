{
  "table_id": "crossing_decision_table",
  "version": "1.1",
  "source": "live_activation_v1.3 \u00a78.7; Doc 1 A5.1; DAP-7; CC-2; ENT-18",
  "invariant": "There is exactly one governed crossing. Every row below is read by the chokepoint's resolution step. A row is never a second route.",
